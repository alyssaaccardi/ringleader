PORT=3002
NODE_ENV=development

# Any long random string. Rotate to log everyone out.
SESSION_SECRET=change-me

# Google OAuth 2.0 Client (create a NEW one, do not reuse CCOB's)
# Authorized redirect URI: https://ringleader.answeringlegal.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://ringleader.answeringlegal.com/auth/google/callback

# Only accounts whose email ends with @<this> can sign in.
ALLOWED_EMAIL_DOMAIN=answeringlegal.com
